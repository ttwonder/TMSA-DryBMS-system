{
  "name": "fpmc-tmsa-drybms-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js --host 127.0.0.1",
    "build": "node node_modules/typescript/bin/tsc --noEmit && node node_modules/vite/bin/vite.js build",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "qa:native": "node scripts/verify-native.mjs",
    "qa:browser": "node scripts/verify-browser.mjs",
    "qa:layout": "node --experimental-strip-types scripts/verify-layout.mjs",
    "qa:audit-layout": "node --experimental-strip-types scripts/verify-audit-layout.mjs",
    "qa:inspection-sections-bulk": "node --experimental-strip-types scripts/verify-inspection-sections-bulk.mjs",
    "qa:improvement-input": "node --experimental-strip-types scripts/verify-improvement-input.mjs",
    "qa:inspection-input": "node --experimental-strip-types scripts/verify-inspection-input.mjs",
    "qa:finding-classification": "node --experimental-strip-types scripts/verify-finding-classification.mjs",
    "qa:finding-classification-reports": "node --experimental-strip-types scripts/verify-finding-classification-reports.mjs",
    "qa:tmsa14": "node --experimental-strip-types scripts/verify-tmsa14.mjs",
    "qa:tmsa14-reports": "node --experimental-strip-types scripts/verify-tmsa14-reports.mjs",
    "qa:inspection-chapter-scores": "node --experimental-strip-types scripts/verify-inspection-chapter-scores.mjs",
    "qa:handoff": "node scripts/verify-deployment-handoff.mjs",
    "qa:read-timeout": "node --experimental-strip-types scripts/verify-read-timeout.mjs",
    "qa:performance": "node --experimental-strip-types scripts/verify-performance.mjs",
    "qa:performance-native": "node --experimental-strip-types scripts/verify-performance-native.mjs",
    "qa:performance-races": "node --experimental-strip-types scripts/verify-performance-races.mjs",
    "qa:report-mounted": "node --experimental-strip-types scripts/verify-report-mounted.mjs",
    "qa:excel-header-removal": "node --experimental-strip-types scripts/verify-excel-header-removal.mjs",
    "qa:report-fallback": "node --experimental-strip-types scripts/verify-report-fallback-browser.mjs",
    "qa:export-person-references": "node --experimental-strip-types scripts/verify-export-person-references.mjs --ui",
    "qa:framework-initialize": "node --experimental-strip-types scripts/verify-framework-initialize.mjs",
    "qa:restart-updates": "node --experimental-strip-types scripts/verify-restart-updates.mjs",
    "qa:restart-updates-ui": "node --experimental-strip-types scripts/verify-restart-updates-ui.mjs",
    "qa:shared-targets": "node --experimental-strip-types scripts/verify-shared-targets.mjs",
    "qa:shared-targets-ui": "node --experimental-strip-types scripts/verify-shared-targets-ui.mjs",
    "qa:conformity-link": "node --experimental-strip-types scripts/verify-conformity-link-ui.mjs",
    "qa:chapter-navigation": "node --experimental-strip-types scripts/verify-chapter-navigation-ui.mjs",
    "qa:inspection-layout-gap": "node --experimental-strip-types scripts/verify-inspection-layout-and-score-gap.mjs",
    "qa:inspection-history": "node scripts/verify-inspection-history-followup.mjs",
    "qa:shared-targets-regression": "node scripts/verify-native.mjs --shared-targets",
    "import:sources": "python3 scripts/import_sources.py"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "exceljs": "4.4.0",
    "jszip": "3.10.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "vite": "8.1.3",
    "typescript": "6.0.3",
    "pg": "8.16.3",
    "pdf-lib": "1.17.1",
    "@pdf-lib/fontkit": "1.1.1",
    "@playwright/test": "1.58.2"
